{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeatherStyler",
  "version": "0.1.0",
  "identifier": "com.weatherstyler.desktop",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "WeatherStyler",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://127.0.0.1:5267 tauri://localhost https://tauri.localhost asset:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/e_sqlite3.dll"
    ]
  }
}